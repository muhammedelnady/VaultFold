{
  "expo": {
    "name": "VaultFold",
    "slug": "vaultfold",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "vaultfold",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0F1A",
    "ios": {
      "backgroundColor": "#0B0F1A",
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.vaultfold.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "VaultFold uses your device's biometrics (Face ID, Touch ID, or passcode) to lock your portfolio vault."
      },
      "privacyManifests": {
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vaultfold.app",
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-dev-client",
      "expo-notifications",
      "expo-secure-store",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VaultFold uses your device's biometrics (Face ID, Touch ID, or passcode) to lock your portfolio vault."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "<YOUR_EAS_PROJECT_ID_HERE>"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
