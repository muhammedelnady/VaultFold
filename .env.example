# VaultFold environment template.
# Copy to .env.local for real values. NEVER commit real keys.
# Only put public, non-secret configuration here.

EXPO_PUBLIC_COINGECKO_DEMO_KEY=<YOUR_COINGECKO_DEMO_API_KEY_HERE>
EXPO_PUBLIC_CG_BURST=6
EXPO_PUBLIC_CG_WINDOW_MS=60000
EXPO_PUBLIC_REVIEW_MODE=0
EXPO_PUBLIC_E2E=0
EXPO_PUBLIC_ENVIRONMENT=development
